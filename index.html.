/* ============ NOTES COUNTER + EXPORT ============ */
function allNoteEntries(){
  const out = [];
  DATA.sections.forEach(sec=>{
    sec.pages.forEach(p=>{
      p.blocks.forEach(b=>{
        if(b.type==='note'){
          b.items.forEach((text,idx)=>{
            out.push({
              sectionTitle: sec.title+(sec.subtitle?' · '+sec.subtitle:''),
              pageTitle: p.title,
              storeId: 'note_'+b.id+'_'+idx,
              text: text
            });
          });
        }
      });
    });
  });
  return out;
}
function allPagesFlat(){
  // returns [{key, sectionTitle, pageTitle}] including the cover page
  const out = [{ key:'cover', sectionTitle:'Обложка', pageTitle:'Обложка' }];
  DATA.sections.forEach(sec=>{
    sec.pages.forEach(p=>{
      out.push({ key: sec.id+'-'+p.id, sectionTitle: sec.title+(sec.subtitle?' · '+sec.subtitle:''), pageTitle: p.title });
    });
  });
  return out;
}
function updateNotesCounter(){
  const all = allNoteEntries();
  const done = getDone();
  const checkedCount = all.filter(n=>!!done[n.storeId]).length;
  const userNotesMap = getUserNotesMap();
  const userNotesCount = Object.values(userNotesMap).reduce((s,arr)=>s+arr.length,0);
  const editsCount = Object.keys(getEdits()).length;
  const counterEl = document.getElementById('notesCounter');
  if(counterEl) counterEl.textContent = checkedCount+' из '+all.length+' отмечено · '+userNotesCount+' своих заметок · '+editsCount+' правок текста';
}
updateNotesCounter();

async function pageHasAttachment(pageKey){
  try{ const f = await idbGet('pagefile_'+pageKey); return f ? f.name : null; }catch(e){ return null; }
}

document.getElementById('exportNotesBtn').addEventListener('click', async ()=>{
  const allChecklist = allNoteEntries();
  const done = getDone();
  const checked = allChecklist.filter(n=>!!done[n.storeId]);
  const userNotesMap = getUserNotesMap();
  const edits = getEdits();
  const pages = allPagesFlat();

  // group everything by page
  const byPage = {};
  function ensure(key, sectionTitle, pageTitle){
    if(!byPage[key]) byPage[key] = { sectionTitle, pageTitle, checklist:[], userNotes:[], editedText:null, attachment:null };
    return byPage[key];
  }

  DATA.sections.forEach(sec=>{
    sec.pages.forEach(p=>{
      const pageKey = sec.id+'-'+p.id;
      checked.filter(n=>n.pageTitle===p.title && n.sectionTitle===(sec.title+(sec.subtitle?' · '+sec.subtitle:''))).forEach(n=>{
        ensure(pageKey, n.sectionTitle, n.pageTitle).checklist.push(n.text);
      });
    });
  });

  pages.forEach(pg=>{
    const notes = userNotesMap[pg.key] || [];
    if(notes.length){
      notes.forEach(n=> ensure(pg.key, pg.sectionTitle, pg.pageTitle).userNotes.push(n.text));
    }
  });

  Object.keys(edits).forEach(blockId=>{
    const pageKey = blockId.replace(/_\d+$/, '');
    const pg = pages.find(x=>x.key===pageKey);
    if(pg){
      const tmp = document.createElement('div');
      tmp.innerHTML = edits[blockId].replace(/<\/(li|p|div|h4|h5)>/g, '$& ');
      const plain = tmp.textContent.replace(/\s+/g,' ').trim();
      const entry = ensure(pageKey, pg.sectionTitle, pg.pageTitle);
      if(!entry.editedText) entry.editedText = [];
      entry.editedText.push(plain);
    }
  });

  for(const pg of pages){
    const fname = await pageHasAttachment(pg.key);
    if(fname){ ensure(pg.key, pg.sectionTitle, pg.pageTitle).attachment = fname; }
  }

  const keys = Object.keys(byPage);
  if(keys.length===0){
    toast('Пока нечего экспортировать — отметьте пункты, добавьте заметку, правку или файл');
    return;
  }

  let text = 'Правки для Академии «Дизайнер» — прошу исправить следующее:\n';
  keys.forEach(key=>{
    const pg = byPage[key];
    text += '\n'+pg.sectionTitle+' — '+pg.pageTitle+'\n';
    pg.checklist.forEach(t=> text += '- [из аудита] '+t+'\n');
    pg.userNotes.forEach(t=> text += '- [моя заметка] '+t+'\n');
    if(pg.editedText){
      pg.editedText.forEach(t=> text += '- [я отредактировал текст на странице, новая версия]: '+t+'\n');
    }
    if(pg.attachment){
      text += '- [приложен файл-образец]: '+pg.attachment+' — если нужно, чтобы Claude использовал его содержимое, прикрепите этот файл отдельным сообщением в чате.\n';
    }
  });

  try{
    await navigator.clipboard.writeText(text.trim());
  }catch(err){
    const ta = document.createElement('textarea');
    ta.value = text.trim(); document.body.appendChild(ta); ta.select();
    document.execCommand('copy'); document.body.removeChild(ta);
  }
  toast('Скопировано по '+keys.length+' страниц(ам). Вставьте это в чат с Claude.');
});

/* ============ BACKUP EXPORT / IMPORT ============ */
async function idbExportAllFiles(){
  const out = {};
  if(!(await idbCapable())) return out;
  try{
    const db = await openDB();
    const keys = await new Promise((res,rej)=>{
      const tx = db.transaction(STORE,'readonly');
      const rq = tx.objectStore(STORE).getAllKeys();
      rq.onsuccess=()=>res(rq.result); rq.onerror=()=>rej(rq.error);
    });
    for(const k of keys){
      const val = await new Promise((res,rej)=>{
        const tx = db.transaction(STORE,'readonly');
        const rq = tx.objectStore(STORE).get(k);
        rq.onsuccess=()=>res(rq.result); rq.onerror=()=>rej(rq.error);
      });
      if(val instanceof Blob){
        const dataURL = await fileToDataURL(val);
        out[k] = { name: val.name||'файл', type: val.type||'', dataURL };
      }
    }
  }catch(e){ console.error('backup export failed', e); }
  return out;
}
async function buildBackupObject(){
  const backup = { version:1, exportedAt: new Date().toISOString(), localStorage:{}, files:{} };
  Object.keys(localStorage).forEach(k=>{
    if(k.startsWith('academy')) backup.localStorage[k] = localStorage.getItem(k);
  });
  backup.files = await idbExportAllFiles();
  return backup;
}
document.getElementById('backupExportBtn').addEventListener('click', async ()=>{
  toast('Готовлю резервную копию…');
  const backup = await buildBackupObject();
  const blob = new Blob([JSON.stringify(backup)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const stamp = new Date().toISOString().slice(0,16).replace(/[:T]/g,'-');
  a.href = url; a.download = 'academy-backup-'+stamp+'.json';
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url), 2000);
  toast('Бэкап скачан — сохраните его отдельно от самого файла академии');
});
document.getElementById('backupImportInput').addEventListener('change', async (e)=>{
  const file = e.target.files && e.target.files[0];
  if(!file) return;
  if(!confirm('Восстановить данные из этого бэкапа? Текущие фото, правки и заметки в этом браузере будут заменены.')){
    e.target.value=''; return;
  }
  try{
    const text = await file.text();
    const backup = JSON.parse(text);
    Object.keys(backup.localStorage||{}).forEach(k=>{
      localStorage.setItem(k, backup.localStorage[k]);
    });
    const entries = Object.entries(backup.files||{});
    for(const [key, info] of entries){
      const blob = dataURLtoBlob(info.dataURL, info.name);
      await idbSet(key, blob);
    }
    toast('Бэкап восстановлен — обновляю страницу…');
    setTimeout(()=>location.reload(), 1200);
  }catch(err){
    console.error('backup import failed', err);
    toast('Не удалось прочитать файл бэкапа — проверьте, что он не повреждён');
  }
  e.target.value='';
});

