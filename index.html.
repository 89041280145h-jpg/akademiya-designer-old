function setDone(id,val){ const d=getDone(); if(val) d[id]=true; else delete d[id]; localStorage.setItem('academyDone', JSON.stringify(d)); }

function toast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  clearTimeout(t._timer);
  t._timer=setTimeout(()=>t.classList.remove('show'),2400);
}
</script>

<script>
/* ============ BLOCK RENDERERS ============ */
function esc(s){ return (s===undefined||s===null) ? '' : String(s); }

function rLead(b){ return `<div class="b-lead">${esc(b.text)}</div>`; }
function rP(b){ return `<div class="b-p">${esc(b.text)}</div>`; }
function rQuote(b){ return `<div class="b-quote"><div class="b-quote-inner">${esc(b.text)}</div></div>`; }

function rList(b){
  const items = b.items.map(it=>{
    if(typeof it === 'string') return `<li><span class="bullet"></span><span>${it}</span></li>`;
    return `<li><span class="bullet"></span><span><span class="lbl">${esc(it.label)}.</span> ${esc(it.text)}</span></li>`;
  }).join('');
  return `<div class="b-list-wrap">${b.title?`<h4 style="margin:0 0 4px;font-size:15px;font-weight:700;">${b.title}</h4>`:''}<ul class="b-list">${items}</ul></div>`;
}

function rCallout(b){
  return `<div class="b-callout"><div class="ic">${icon(b.icon||'alert',22)}</div><div class="tx">${esc(b.text)}</div></div>`;
}

function rCards(b){
  const cols = b.cols || 3;
  const items = b.items.map(it=>`
    <div class="card">
      <div class="ic-wrap">${icon(it.icon||'star',20)}</div>
      <h4>${esc(it.title)}</h4>
      <p>${esc(it.text)}</p>
    </div>`).join('');
  return `<div class="grid grid-${cols}">${items}</div>`;
}

function rSteps(b){
  const items = b.items.map(it=>`
    <div class="step-card">
      <div class="num">${esc(it.n)}</div>
      <h4>${esc(it.title)}</h4>
      ${it.text?`<p>${esc(it.text)}</p>`:''}
    </div>`).join('');
  return `<div class="steps-grid">${items}</div>`;
}

function rTwocol(b){
  const mkCol = (col)=>`
    <div class="twocol-col">
      <h4>${esc(col.title)}</h4>
      <ul>${col.items.map(i=>`<li>${esc(i)}</li>`).join('')}</ul>
    </div>`;
  return `<div class="twocol">${mkCol(b.colA)}${mkCol(b.colB)}</div>`;
}

function rChecklist(b){
  const done = getDone();
  const items = b.items.map((it,idx)=>{
    const id = b.id+'_'+idx;
    const isDone = !!done[id];
    return `<div class="cl-item ${isDone?'checked':''}" data-clid="${id}">
      <div class="cl-box">${isDone?icon('check',12):''}</div>
      <div class="cl-text">${esc(it)}</div>
    </div>`;
  }).join('');
  return `<div class="checklist">${items}</div>${b.note?`<div class="b-p" style="margin-top:12px;font-size:13px;">${esc(b.note)}</div>`:''}`;
}

function rGlossary(b){
  const cols = b.columns.map(col=>`
    <div class="gloss-col">
      <h4>${esc(col.title)}</h4>
      ${col.items.map(i=>`<div class="gloss-row"><div class="gloss-term">${esc(i.term)}</div><div class="gloss-def">${esc(i.def)}</div></div>`).join('')}
    </div>`).join('');
  return `<div class="gloss-grid">${cols}</div>`;
}

function rSegment(b){
  return `<div class="segment">
    <div class="segment-letter">${esc(b.letter)}</div>
    <div class="segment-body">
      <h4>${esc(b.title)}</h4>
      <p>${esc(b.text)}</p>
      <div class="sub">Что делать</div>
      <ul class="b-list">${b.items.map(i=>`<li><span class="bullet"></span><span>${esc(i)}</span></li>`).join('')}</ul>
    </div>
  </div>`;
}

function rPeople(b){
  const PORTRAIT_PROMPT = "Портрет сотрудника по пояс или крупным планом: нейтральный светлый фон (стена шоурума или офиса), опрятная деловая-casual одежда, естественная доброжелательная улыбка, взгляд в камеру. Мягкий равномерный дневной свет, как для корпоративного портрета. Реалистичное фото, без текста и логотипов в кадре.";
  const items = b.items.map((p)=>`
    <div class="person-card">
      ${photoSlotHTML(p.id, p.dept||PORTRAIT_PROMPT, 170)}
      <div class="pmeta">
        ${editableFieldHTML(p.id+'_name', p.name||'', 'ФИО', 'div').replace('class="editable-field"','class="editable-field pname"')}
        ${editableFieldHTML(p.id+'_role', p.role||'', 'Должность · Подразделение', 'div').replace('class="editable-field"','class="editable-field prole"')}
        ${editableFieldHTML(p.id+'_note', p.note||'', 'Какие вопросы решает', 'div').replace('class="editable-field"','class="editable-field pnote"')}
      </div>
    </div>`).join('');
  return `<div class="people-grid">${items}</div>`;
}

function rPhoto(b){ return photoSlotHTML(b.id, b.caption, 240); }
function rPhotogrid(b){
  const items = b.items.map(it=>photoSlotHTML(it.id, it.caption, 180)).join('');
  return `<div class="photo-grid">${items}</div>`;
}

function rResources(b, blockId){
  const groupId = 'resgrp_'+(blockId||b.id||Math.random().toString(36).slice(2));
  const meta = getGroupMeta(groupId);
  const originalItems = b.items.filter(it=>!meta.deleted.includes(it.id));
  const customItems = meta.added.map(cid=>({id:cid, title:'', text:''}));
  const allItems = originalItems.concat(customItems);
  const cardsHTML = allItems.map(it=>resourceCardHTML(it.id, it.title, it.text, groupId)).join('');
  return `<div class="resource-grid" data-group-id="${groupId}">${cardsHTML}
    <button type="button" class="resource-add-card" data-add-card-group="${groupId}"><span class="plus">+</span>Добавить карточку</button>
  </div>`;
}

function rContact(b){
  return `<div class="contact-card">
    <div style="width:52px;height:52px;border-radius:14px;margin:0 auto 14px;background:rgba(255,255,255,.1);color:#fff;display:flex;align-items:center;justify-content:center;">${icon('message',22)}</div>
    <div style="font-size:19px;font-weight:700;">${esc(b.text)}</div>
    <div class="handle">${esc(b.handle)}</div>
    <div class="tagline">${esc(b.tagline)}</div>
  </div>`;
}

function rNote(b){
  const done = getDone();
  const items = b.items.map((it,idx)=>{
    const id = 'note_'+b.id+'_'+idx;
    const isDone = !!done[id];
    return `<li data-noteid="${id}" class="${isDone?'done':''}"><span class="rn-box">${isDone?icon('check',10):''}</span><span>${esc(it)}</span></li>`;
  }).join('');
  const labels = {P0:'Сделать в первую очередь', P1:'Стоит поправить', P2:'Можно доработать позже'};
  return `<div class="rev-note" data-level="${b.level}">
    <div class="rev-note-head"><span class="rev-note-badge">${esc(b.level)}</span><span class="rev-note-label">${labels[b.level]||'Заметка'}</span></div>
    <ul>${items}</ul>
  </div>`;
}

const BLOCK_RENDERERS = {
  lead: rLead, p: rP, quote: rQuote, list: rList, callout: rCallout,
  cards: rCards, steps: rSteps, twocol: rTwocol, checklist: rChecklist,
  glossary: rGlossary, segment: rSegment, people: rPeople,
  photo: rPhoto, photogrid: rPhotogrid, resources: rResources, contact: rContact,
  note: rNote
};

const EDITABLE_TYPES = ['lead','p','quote','list','callout','cards','steps','twocol','glossary','contact','segment'];

function getEdits(){ try{ return JSON.parse(localStorage.getItem('academyEdits')||'{}'); }catch(e){ return {}; } }
function getBlockEdit(id){ const m = getEdits(); return Object.prototype.hasOwnProperty.call(m,id) ? m[id] : null; }
function setBlockEdit(id, html){ const m = getEdits(); m[id]=html; localStorage.setItem('academyEdits', JSON.stringify(m)); }
function clearBlockEdit(id){ const m = getEdits(); delete m[id]; localStorage.setItem('academyEdits', JSON.stringify(m)); }

/* ---- Small editable text fields (ФИО, должность, названия карточек и т.п.) ---- */
function getFieldEdits(){ try{ return JSON.parse(localStorage.getItem('academyFieldEdits')||'{}'); }catch(e){ return {}; } }
function getFieldEdit(id, fallback){ const m=getFieldEdits(); return Object.prototype.hasOwnProperty.call(m,id) ? m[id] : fallback; }
function setFieldEdit(id, val){ const m=getFieldEdits(); m[id]=val; localStorage.setItem('academyFieldEdits', JSON.stringify(m)); }
function editableFieldHTML(id, fallbackText, placeholder, tag){
  tag = tag || 'span';
  const text = getFieldEdit(id, fallbackText||'');
  return `<${tag} class="editable-field" contenteditable="true" spellcheck="false" data-field-id="${id}" data-placeholder="${esc(placeholder||'')}">${esc(text)}</${tag}>`;
}
function mountEditableFields(container){
  container.querySelectorAll('.editable-field').forEach(el=>{
    if(el._wired) return;
    el._wired = true;
    el.addEventListener('blur', ()=>{
      setFieldEdit(el.getAttribute('data-field-id'), el.innerText.trim());
    });
  });
}

/* ---- Dynamic card groups: add / delete cards inside a "resources" block ---- */
function getCardGroups(){ try{ return JSON.parse(localStorage.getItem('academyCardGroups')||'{}'); }catch(e){ return {}; } }
function getGroupMeta(groupId){ const m = getCardGroups(); return m[groupId] || {added:[], deleted:[]}; }
function saveGroupMeta(groupId, meta){ const m = getCardGroups(); m[groupId]=meta; localStorage.setItem('academyCardGroups', JSON.stringify(m)); }
function addCardToGroup(groupId){
  const meta = getGroupMeta(groupId);
  const newId = 'custom_'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);
  meta.added.push(newId);
  saveGroupMeta(groupId, meta);
  return newId;
}
function deleteCardFromGroup(groupId, cardId){
  const meta = getGroupMeta(groupId);
  if(meta.added.includes(cardId)){
    meta.added = meta.added.filter(x=>x!==cardId);
  } else if(!meta.deleted.includes(cardId)){
    meta.deleted.push(cardId);
  }
  saveGroupMeta(groupId, meta);
}

function renderBlock(b, blockId){
  const fn = BLOCK_RENDERERS[b.type];
  if(!fn){ return ''; }
  if(blockId && EDITABLE_TYPES.includes(b.type)){
    const saved = getBlockEdit(blockId);
    const inner = saved!==null ? saved : fn(b, blockId);
    const isEdited = saved!==null;
    return `<div class="page-block">
      <div class="editable-block ${isEdited?'is-edited':''}" contenteditable="true" spellcheck="false" data-block-id="${blockId}">${isEdited?`<span class="edited-tag" contenteditable="false">${icon('check',10)} правка<button type="button" data-revert-block>вернуть оригинал</button></span>`:''}${inner}</div>
    </div>`;
  }
  return `<div class="page-block">${fn(b, blockId)}</div>`;
}

/* ============ MEDIA SLOT HTML ============ */
function photoSlotHTML(id, caption, minH){
  return `<div class="photo-slot" data-media-id="${id}" data-media-kind="photo" style="min-height:${minH}px">
    <input type="file" accept="image/*,video/*">
    <div class="photo-slot-empty">
      ${icon('camera',34)}
      <div class="cap-main">Загрузить фото</div>
      <div class="cap-sub" data-prompt-text>${esc(caption)||'нажмите или перетащите файл'}</div>
      <button type="button" class="copy-prompt-btn" data-copy-btn>${icon('clipboard',12)} Скопировать описание</button>
    </div>
  </div>`;
}

function resourceCardHTML(id, title, text, groupId){
  return `<div class="resource-card" data-res-id="${id}" data-group-id="${groupId||''}">
    <button type="button" class="res-card-del" data-del-card title="Удалить карточку">${icon('trash',13)}</button>
    <div class="ric">${icon('filetext',18)}</div>
    ${editableFieldHTML('rtitle_'+id, title||'', 'Название карточки', 'h5')}
    ${editableFieldHTML('rtext_'+id, text||'', 'Короткое описание', 'p')}
    <div class="res-slot-row">
      <span class="res-slot-label">${icon('filetext',12)} Документ</span>
      <div class="res-actions" data-res-actions data-res-id="doc:${id}"></div>
    </div>
    <div class="res-slot-row">
      <span class="res-slot-label">${icon('video',12)} Видео</span>
      <div class="res-actions" data-res-actions data-res-id="video:${id}"></div>
    </div>
  </div>`;
}

/* ============ MOUNT MEDIA SLOTS ============ */
async function mountPhotoSlots(container){
  const slots = container.querySelectorAll('.photo-slot');
  for(const slot of slots){
    const id = slot.getAttribute('data-media-id');
    const input = slot.querySelector('input');
    try{
      const file = await idbGet('photo:'+id);
      if(file) renderPhotoPreview(slot, file);
    }catch(e){}

    slot.addEventListener('click', (e)=>{ if(!slot.classList.contains('has-media')) input.click(); });
    const copyBtn = slot.querySelector('[data-copy-btn]');
    if(copyBtn){
      copyBtn.addEventListener('click', async (e)=>{
        e.stopPropagation();
        const txt = slot.querySelector('[data-prompt-text]').innerText;
        try{
          await navigator.clipboard.writeText(txt);
          toast('Описание скопировано');
        }catch(err){
          const ta = document.createElement('textarea');
          ta.value = txt; document.body.appendChild(ta); ta.select();
          document.execCommand('copy'); document.body.removeChild(ta);
          toast('Описание скопировано');
        }
      });
    }
    input.addEventListener('change', async ()=>{
      if(input.files && input.files[0]){
        const f = input.files[0];
        try{
          await idbSet('photo:'+id, f);
          renderPhotoPreview(slot, f);
          toast('Файл сохранён');
        }catch(err){
          toast('Не удалось сохранить файл — см. подсказку под кнопкой очистки в сайдбаре');
          console.error('photo upload failed', err);
        }
      }
    });
    ['dragover','dragenter'].forEach(ev=>slot.addEventListener(ev,(e)=>{e.preventDefault();slot.classList.add('drag-over');}));
    ['dragleave','drop'].forEach(ev=>slot.addEventListener(ev,(e)=>{e.preventDefault();slot.classList.remove('drag-over');}));
    slot.addEventListener('drop', async (e)=>{
      e.preventDefault();
      const f = e.dataTransfer.files && e.dataTransfer.files[0];
      if(f){
        try{
          await idbSet('photo:'+id, f);
          renderPhotoPreview(slot, f);
          toast('Файл сохранён');
        }catch(err){
          toast('Не удалось сохранить файл — см. подсказку под кнопкой очистки в сайдбаре');
          console.error('photo drop upload failed', err);
        }
      }
    });
  }
}
function renderPhotoPreview(slot, file){
  slot.classList.add('has-media');
  const url = URL.createObjectURL(file);
  const isVideo = file.type.startsWith('video');
  slot.innerHTML = `
    ${isVideo? `<video src="${url}" controls></video>` : `<img src="${url}">`}
    <button class="media-remove" type="button">${icon('trash',15)}</button>
  `;
  slot.querySelector('.media-remove').addEventListener('click', async (e)=>{
    e.stopPropagation();
    const id = slot.getAttribute('data-media-id');
    await idbDelete('photo:'+id);
    location.reload();
  });
}

async function mountResourceSlots(container){
  const cards = container.querySelectorAll('.resource-card');
  for(const card of cards){
    const actionEls = card.querySelectorAll('[data-res-actions]');
    for(const actionsEl of actionEls){
      const fullId = actionsEl.getAttribute('data-res-id');
      await renderResourceActions(fullId, actionsEl);
    }
    const delBtn = card.querySelector('[data-del-card]');
    if(delBtn){
      delBtn.addEventListener('click', ()=>{
        const cardId = card.getAttribute('data-res-id');
        const groupId = card.getAttribute('data-group-id');
        if(confirm('Удалить эту карточку? Прикреплённые к ней файлы тоже будут удалены.')){
          deleteCardFromGroup(groupId, cardId);
          idbDelete('res:doc:'+cardId);
          idbDelete('res:video:'+cardId);
          removeLink('doc:'+cardId);
          removeLink('video:'+cardId);
          router();
        }
      });
    }
  }
  mountEditableFields(container);
  container.querySelectorAll('[data-add-card-group]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const groupId = btn.getAttribute('data-add-card-group');
      addCardToGroup(groupId);
      router();
    });
  });
}
async function renderResourceActions(id, el){
  const links = getLinks();
  const link = links[id];
  let file = null;
  try{ file = await idbGet('res:'+id); }catch(e){}

  if(link){
    el.innerHTML = `<div class="res-filled"><a href="${esc(link)}" target="_blank" rel="noopener">${icon('link',13)} ${esc(link)}</a><button data-act="rmlink">${icon('x',14)}</button></div>`;
    el.querySelector('[data-act="rmlink"]').addEventListener('click', ()=>{ removeLink(id); renderResourceActions(id, el); });
    return;
  }
  if(file){
    const url = URL.createObjectURL(file);
    el.innerHTML = `<div class="res-filled"><a href="${url}" target="_blank" rel="noopener">${icon('check',13)} ${esc(file.name)}</a><button data-act="rmfile">${icon('x',14)}</button></div>`;
    el.querySelector('[data-act="rmfile"]').addEventListener('click', async ()=>{ await idbDelete('res:'+id); renderResourceActions(id, el); });
    return;
  }
  el.innerHTML = `
    <button class="res-btn primary" data-act="link">${icon('link',13)} Ссылка</button>
    <label class="res-btn" data-act="upload">${icon('upload',13)} Файл<input type="file"></label>
  `;
  el.querySelector('[data-act="link"]').addEventListener('click', ()=>{
    const url = prompt('Вставьте ссылку:');
    if(url){ setLink(id, url.trim()); renderResourceActions(id, el); }
  });
  el.querySelector('input').addEventListener('change', async (e)=>{
    if(e.target.files && e.target.files[0]){
      try{
        await idbSet('res:'+id, e.target.files[0]);
        renderResourceActions(id, el);
        toast('Файл сохранён');
      }catch(err){
        toast('Не удалось сохранить файл — он может быть слишком большим для этого браузера');
        console.error('resource upload failed', err);
      }
    }
  });
}

function mountChecklist(container){
  container.querySelectorAll('.cl-item').forEach(item=>{
    item.addEventListener('click', ()=>{
      const id = item.getAttribute('data-clid');
      const nowDone = !item.classList.contains('checked');
      setDone(id, nowDone);
      item.classList.toggle('checked', nowDone);
      item.querySelector('.cl-box').innerHTML = nowDone? icon('check',12) : '';
    });
  });
}

function mountNotes(container){
  container.querySelectorAll('.rev-note li').forEach(li=>{
    li.addEventListener('click', ()=>{
      const id = li.getAttribute('data-noteid');
      const nowDone = !li.classList.contains('done');
      setDone(id, nowDone);
      li.classList.toggle('done', nowDone);
      li.querySelector('.rn-box').innerHTML = nowDone? icon('check',10) : '';
      if(typeof updateNotesCounter === 'function') updateNotesCounter();
    });
  });
}

/* ============ EDITABLE TEXT BLOCKS ============ */
function mountEditableBlocks(container){
  container.querySelectorAll('.editable-block').forEach(el=>{
    el.addEventListener('blur', ()=>{
      const id = el.getAttribute('data-block-id');
      const tag = el.querySelector('.edited-tag');
      const cleanHTML = el.innerHTML.replace(/<span class="edited-tag"[\s\S]*?<\/span>/,'');
      setBlockEdit(id, cleanHTML);
      if(!tag){
        const span = document.createElement('span');
        span.className='edited-tag'; span.setAttribute('contenteditable','false');
        span.innerHTML = icon('check',10)+' правка<button type="button" data-revert-block>вернуть оригинал</button>';
        el.prepend(span);
        el.classList.add('is-edited');
        wireRevertButton(span.querySelector('[data-revert-block]'), el, id);
      }
    });
    const revertBtn = el.querySelector('[data-revert-block]');
    if(revertBtn) wireRevertButton(revertBtn, el, el.getAttribute('data-block-id'));
  });
}
function wireRevertButton(btn, el, id){
  if(!btn) return;
  btn.addEventListener('click', (e)=>{
    e.stopPropagation(); e.preventDefault();
    clearBlockEdit(id);
    router();
    toast('Правка отменена — вернулся оригинальный текст');
  });
}

/* ============ PAGE ATTACHMENTS (reference files) ============ */
async function mountPageAttach(pageId, container){
  const wrap = container.querySelector(`[data-attach-page="${pageId}"]`);
  if(!wrap) return;
  let file = null;
  try{ file = await idbGet('pagefile_'+pageId); }catch(e){}
  if(file){
    const url = URL.createObjectURL(file);
    wrap.innerHTML = `<div class="page-attach-chip">${icon('filetext',14)}<a href="${url}" target="_blank" rel="noopener">${esc(file.name)}</a><button type="button" data-rm-attach>${icon('x',13)}</button></div>`;
    wrap.querySelector('[data-rm-attach]').addEventListener('click', async ()=>{
      await idbDelete('pagefile_'+pageId);
      mountPageAttach(pageId, container);
    });
  } else {
    wrap.innerHTML = '';
  }
}
function wireAttachInputs(container){
  container.querySelectorAll('[data-attach-input]').forEach(input=>{
    input.addEventListener('change', async ()=>{
      const pageId = input.getAttribute('data-attach-input');
      if(input.files && input.files[0]){
        try{
          await idbSet('pagefile_'+pageId, input.files[0]);
          mountPageAttach(pageId, container);
          toast('Файл прикреплён к странице');
        }catch(err){
          toast('Не удалось сохранить файл — он может быть слишком большим для этого браузера');
          console.error('page attach failed', err);
        }
      }
    });
  });
}

/* ============ USER NOTES (свои заметки) ============ */
function getUserNotesMap(){ try{ return JSON.parse(localStorage.getItem('academyUserNotes')||'{}'); }catch(e){ return {}; } }
function getUserNotes(pageId){ return getUserNotesMap()[pageId] || []; }
function addUserNote(pageId, text){
  const m = getUserNotesMap();
  if(!m[pageId]) m[pageId] = [];
  m[pageId].push({ id:'u'+Date.now().toString(36)+Math.random().toString(36).slice(2,6), text });
  localStorage.setItem('academyUserNotes', JSON.stringify(m));
}
function removeUserNote(pageId, noteId){
  const m = getUserNotesMap();
  if(m[pageId]) m[pageId] = m[pageId].filter(n=>n.id!==noteId);
  localStorage.setItem('academyUserNotes', JSON.stringify(m));
}
function mountUserNotes(pageId, container){
  const wrap = container.querySelector(`[data-usernotes-page="${pageId}"]`);
  if(!wrap) return;
  const notes = getUserNotes(pageId);
  wrap.innerHTML = notes.map(n=>`
    <div class="user-note" data-note-id="${n.id}">
      <div class="un-ic">${icon('message',16)}</div>
      <div class="un-text">${esc(n.text)}</div>
      <button type="button" class="un-del">${icon('trash',13)}</button>
    </div>`).join('');
  wrap.querySelectorAll('.user-note .un-del').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const noteEl = btn.closest('.user-note');
      removeUserNote(pageId, noteEl.getAttribute('data-note-id'));
      mountUserNotes(pageId, container);
      if(typeof updateNotesCounter==='function') updateNotesCounter();
    });
  });
}
function mountAddNoteButton(pageId, container){
  const btn = container.querySelector(`[data-addnote-page="${pageId}"]`);
  if(!btn) return;
  btn.addEventListener('click', ()=>{
    if(btn.dataset.open) return;
    btn.dataset.open = '1';
    btn.style.display = 'none';
    const form = document.createElement('div');
    form.className = 'usernote-form';
    form.innerHTML = `<textarea placeholder="Чего не хватает на этой странице? Опишите, что нужно поправить или дописать."></textarea>
      <div class="usernote-form-actions">
        <button type="button" data-save>Сохранить</button>
        <button type="button" data-cancel>Отмена</button>
      </div>`;
    btn.parentElement.insertBefore(form, btn);
    form.querySelector('textarea').focus();
    form.querySelector('[data-save]').addEventListener('click', ()=>{
      const val = form.querySelector('textarea').value.trim();
      if(val){
        addUserNote(pageId, val);
        mountUserNotes(pageId, container);
        if(typeof updateNotesCounter==='function') updateNotesCounter();
      }
      form.remove(); btn.style.display=''; delete btn.dataset.open;
    });
    form.querySelector('[data-cancel]').addEventListener('click', ()=>{
      form.remove(); btn.style.display=''; delete btn.dataset.open;
    });
  });
}
