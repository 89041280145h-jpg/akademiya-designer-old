<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>МОДЕРНМ — Академия знаний «Дизайнер»</title>
<style>
:root{
  --bg:#FAFAF8;
  --surface:#FFFFFF;
  --ink:#211E1B;
  --ink-soft:#645D54;
  --ink-faint:#9A9188;
  --line:#EBE5DC;
  --accent:#B5602A;
  --accent-ink:#8A491F;
  --accent-soft:#F5E5D6;
  --accent-soft2:#FBF1E7;
  --gold:#9C7A2E;
  --sidebar-bg:#1A1815;
  --sidebar-bg2:#232019;
  --sidebar-ink:#EFE9E1;
  --sidebar-soft:#948C81;
  --sidebar-line:#332F28;
  --radius:16px;
  --radius-sm:10px;
  --shadow:0 1px 2px rgba(30,25,15,.04), 0 8px 24px -12px rgba(30,25,15,.10);
  --shadow-lg:0 20px 60px -20px rgba(20,15,5,.35);
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  line-height:1.5;
}
::selection{background:var(--accent-soft);color:var(--accent-ink);}
a{color:inherit;}
button{font-family:inherit;}

.app{display:flex;min-height:100vh;}

.sidebar{
  width:288px;flex:0 0 288px;
  background:linear-gradient(180deg,var(--sidebar-bg),var(--sidebar-bg2) 60%);
  color:var(--sidebar-ink);
  position:fixed;top:0;left:0;bottom:0;
  overflow-y:auto;
  z-index:40;
  transition:transform .25s ease;
}
.sidebar::-webkit-scrollbar{width:8px;}
.sidebar::-webkit-scrollbar-thumb{background:var(--sidebar-line);border-radius:8px;}

.sidebar-head{padding:28px 24px 20px;border-bottom:1px solid var(--sidebar-line);}
.sidebar-brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:.06em;font-size:15px;color:#fff;}
.sidebar-brand .dot{width:9px;height:9px;border-radius:50%;background:var(--accent);flex:0 0 9px;}
.sidebar-title{margin-top:14px;font-size:19px;font-weight:700;line-height:1.3;color:#fff;}
.sidebar-title em{color:var(--accent);font-style:normal;}
.sidebar-sub{margin-top:6px;font-size:12.5px;color:var(--sidebar-soft);line-height:1.5;}

.progress-wrap{padding:16px 24px 4px;}
.progress-label{display:flex;justify-content:space-between;font-size:11px;color:var(--sidebar-soft);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em;}
.progress-track{height:6px;border-radius:6px;background:var(--sidebar-line);overflow:hidden;}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--gold));border-radius:6px;transition:width .3s ease;}

.nav{padding:12px 14px 28px;}
.nav-group-label{font-size:10.5px;text-transform:uppercase;letter-spacing:.09em;color:var(--sidebar-soft);padding:16px 10px 6px;font-weight:700;}
.nav-item{display:flex;align-items:center;gap:11px;padding:10px 10px;border-radius:10px;cursor:pointer;color:var(--sidebar-ink);font-size:14px;font-weight:500;margin-bottom:2px;transition:background .15s ease,color .15s ease;position:relative;border:1px solid transparent;}
.nav-item:hover{background:rgba(255,255,255,.05);}
.nav-item.active{background:rgba(181,96,42,.16);border-color:rgba(181,96,42,.35);color:#fff;}
.nav-badge{flex:0 0 26px;height:26px;border-radius:8px;background:var(--sidebar-line);color:var(--sidebar-soft);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;}
.nav-item.active .nav-badge{background:var(--accent);color:#fff;}
.nav-item.done .nav-badge{background:#3C6B4F;color:#fff;font-size:0;}
.nav-item.done .nav-badge::after{content:"✓";font-size:13px;}
.nav-text{flex:1;min-width:0;}
.nav-text .t1{display:block;font-size:13.5px;font-weight:650;color:inherit;}
.nav-text .t2{display:block;font-size:11px;color:var(--sidebar-soft);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

.sidebar-foot{padding:16px 24px 26px;border-top:1px solid var(--sidebar-line);font-size:11.5px;color:var(--sidebar-soft);}
.sidebar-foot button{width:100%;background:rgba(255,255,255,.05);border:1px solid var(--sidebar-line);color:var(--sidebar-soft);padding:9px 10px;border-radius:9px;font-size:12px;cursor:pointer;margin-top:10px;transition:.15s;}
.sidebar-foot button:hover{background:rgba(255,255,255,.09);color:#fff;}

.menu-toggle{display:none;position:fixed;top:14px;left:14px;z-index:50;width:42px;height:42px;border-radius:11px;background:var(--sidebar-bg);color:#fff;border:1px solid var(--sidebar-line);align-items:center;justify-content:center;cursor:pointer;box-shadow:var(--shadow);}
.sidebar-backdrop{display:none;position:fixed;inset:0;background:rgba(10,8,5,.5);z-index:39;}

.main{margin-left:288px;flex:1;min-width:0;}
.topbar{position:sticky;top:0;z-index:20;background:rgba(250,250,248,.86);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);padding:16px 44px;}
.crumbs{font-size:12px;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.06em;font-weight:700;}
.crumbs span{color:var(--accent);}

.content{max-width:860px;margin:0 auto;padding:36px 44px 120px;}

.hero-cover{background:linear-gradient(155deg,var(--sidebar-bg),#2a241c 60%,var(--accent-ink));border-radius:22px;color:#fff;padding:56px 48px;margin-bottom:40px;box-shadow:var(--shadow-lg);position:relative;overflow:hidden;}
.hero-cover::after{content:"";position:absolute;right:-80px;top:-80px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(181,96,42,.35),transparent 70%);}
.hero-eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#E4B98C;font-weight:700;}
.hero-title{font-size:40px;font-weight:800;margin:14px 0 10px;line-height:1.15;}
.hero-title em{color:var(--accent);font-style:normal;}
.hero-desc{font-size:15.5px;color:#D8D2C7;max-width:520px;line-height:1.6;}
.hero-meta{margin-top:26px;font-size:12.5px;color:#B7AF9F;}

.page-kicker{font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:8px;}
.page-title{font-size:27px;font-weight:800;margin:0 0 6px;letter-spacing:-.01em;}
.page-day{font-size:13px;color:var(--ink-faint);margin-bottom:22px;}

.section-head{margin-bottom:8px;}
.section-eyebrow{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);}
.section-title{font-size:32px;font-weight:800;margin:8px 0 4px;letter-spacing:-.015em;}
.section-sub{font-size:15.5px;color:var(--ink-soft);margin-bottom:8px;}

.jumpnav{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 40px;padding:16px;background:var(--surface);border:1px solid var(--line);border-radius:14px;}
.jumpnav-label{width:100%;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-faint);margin-bottom:4px;}
.jumpnav a{font-size:12.5px;font-weight:600;color:var(--ink-soft);background:var(--bg);border:1px solid var(--line);padding:7px 12px;border-radius:20px;text-decoration:none;transition:.15s;}
.jumpnav a:hover{background:var(--accent-soft);border-color:var(--accent-soft);color:var(--accent-ink);}

.page-block{margin-bottom:44px;scroll-margin-top:90px;}
.page-block:last-child{margin-bottom:8px;}

/* ===== Block: text ===== */
.b-lead{font-size:17px;line-height:1.65;color:var(--ink);font-weight:500;}
.b-p{font-size:15px;line-height:1.75;color:var(--ink-soft);margin-top:12px;}
.b-quote{font-size:20px;line-height:1.55;font-weight:600;color:var(--ink);padding:26px 30px;background:var(--accent-soft2);border-radius:16px;position:relative;}
.b-quote::before{content:"“";position:absolute;top:6px;left:18px;font-size:52px;color:var(--accent);opacity:.35;font-weight:800;font-family:Georgia,serif;}
.b-quote-inner{position:relative;padding-left:18px;}

.b-list{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:12px;}
.b-list li{display:flex;gap:12px;font-size:15px;line-height:1.6;color:var(--ink-soft);}
.b-list li .bullet{flex:0 0 6px;height:6px;border-radius:50%;background:var(--accent);margin-top:9px;}
.b-list li b, .b-list li .lbl{color:var(--ink);font-weight:700;}

.b-callout{display:flex;gap:14px;padding:18px 20px;border-radius:14px;background:#FBF4E3;border:1px solid #F0DFB0;}
.b-callout .ic{flex:0 0 auto;color:#96731C;}
.b-callout .tx{font-size:14.5px;color:#5C4A15;line-height:1.6;}

/* ===== Revision notes (заметки для доработки) ===== */
body.hide-notes .rev-note{display:none;}
.rev-note{border-radius:14px;padding:16px 18px 18px;border:1.5px dashed #C9433A;background:#FBEDEA;position:relative;}
.rev-note[data-level="P1"]{border-color:#C97A1F;background:#FBF1E3;}
.rev-note[data-level="P2"]{border-color:#A8901F;background:#FBF6E0;}
.rev-note-head{display:flex;align-items:center;gap:9px;margin-bottom:10px;}
.rev-note-badge{font-size:10px;font-weight:800;letter-spacing:.04em;color:#fff;background:#C9433A;border-radius:6px;padding:3px 7px;flex:0 0 auto;}
.rev-note[data-level="P1"] .rev-note-badge{background:#C97A1F;}
.rev-note[data-level="P2"] .rev-note-badge{background:#A8901F;}
.rev-note-label{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:#7A2A22;}
.rev-note[data-level="P1"] .rev-note-label{color:#7A4A12;}
.rev-note[data-level="P2"] .rev-note-label{color:#6B5912;}
.rev-note ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;}
.rev-note li{display:flex;gap:10px;font-size:13.5px;line-height:1.55;color:#4A2620;cursor:pointer;}
.rev-note[data-level="P1"] li{color:#4A3410;}
.rev-note[data-level="P2"] li{color:#443B0F;}
.rev-note li .rn-box{flex:0 0 17px;height:17px;margin-top:2px;border-radius:5px;border:2px solid rgba(0,0,0,.25);display:flex;align-items:center;justify-content:center;}
.rev-note li.done{opacity:.5;}
.rev-note li.done span:last-child{text-decoration:line-through;}
.rev-note li.done .rn-box{background:currentColor;border-color:currentColor;}
.notes-toggle-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:12px;font-size:12px;color:var(--sidebar-soft);}
.notes-toggle-row button{background:rgba(255,255,255,.05);border:1px solid var(--sidebar-line);color:var(--sidebar-ink);padding:6px 10px;border-radius:8px;font-size:11.5px;cursor:pointer;}
.notes-toggle-row button:hover{background:rgba(255,255,255,.1);}

/* ===== Editable content ===== */
.editable-block{position:relative;border-radius:10px;padding:6px 10px;margin-left:-10px;margin-right:-10px;cursor:text;transition:background .15s,box-shadow .15s;}
.editable-block:hover{background:rgba(181,96,42,.05);box-shadow:0 0 0 1px rgba(181,96,42,.15);}
.editable-block:focus{outline:none;background:#FFFDF9;box-shadow:0 0 0 2px var(--accent);}
.editable-block.is-edited{box-shadow:0 0 0 1.5px #3C6B4F;}
.editable-block.is-edited:hover{box-shadow:0 0 0 1.5px #3C6B4F;}
.edited-tag{position:absolute;top:-11px;right:2px;font-size:9.5px;font-weight:800;letter-spacing:.03em;text-transform:uppercase;background:#3C6B4F;color:#fff;padding:2px 7px;border-radius:6px;display:flex;align-items:center;gap:5px;z-index:2;}
.edited-tag button{background:none;border:none;color:#fff;opacity:.8;cursor:pointer;padding:0;font-size:10px;line-height:1;}
.edited-tag button:hover{opacity:1;}

/* ===== Page tools (add note / attach file) ===== */
.page-tools{display:flex;flex-wrap:wrap;gap:10px;margin:8px 0 18px;}
.page-tool-btn{font-size:12.5px;font-weight:700;color:var(--ink-soft);background:var(--surface);border:1px dashed var(--line);padding:9px 14px;border-radius:10px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:.15s;}
.page-tool-btn:hover{border-color:var(--accent);color:var(--accent-ink);background:var(--accent-soft2);}
.page-tool-btn input{display:none;}

.usernote-form{background:var(--surface);border:1.5px solid var(--accent);border-radius:12px;padding:14px;margin-bottom:14px;flex-basis:100%;width:100%;}
.usernote-form textarea{width:100%;min-height:80px;border:1px solid var(--line);border-radius:8px;padding:10px;font-family:inherit;font-size:13.5px;resize:vertical;}
.usernote-form-actions{display:flex;gap:8px;margin-top:10px;}
.usernote-form-actions button{font-size:12.5px;font-weight:700;padding:7px 14px;border-radius:8px;border:1px solid var(--line);background:var(--bg);cursor:pointer;}
.usernote-form-actions button[data-save]{background:var(--accent);border-color:var(--accent);color:#fff;}

.user-note{display:flex;gap:12px;align-items:flex-start;background:#EAF1EC;border:1.5px dashed #6B9C7C;border-radius:14px;padding:14px 16px;margin-bottom:12px;}
.user-note .un-ic{flex:0 0 auto;color:#2F6B44;margin-top:1px;}
.user-note .un-text{flex:1;font-size:13.5px;color:#284A32;line-height:1.55;white-space:pre-wrap;}
.user-note .un-del{flex:0 0 auto;background:none;border:none;color:#2F6B44;opacity:.6;cursor:pointer;}
.user-note .un-del:hover{opacity:1;}

.page-attach-chip{display:inline-flex;align-items:center;gap:8px;background:var(--accent-soft2);border:1px solid var(--accent-soft);border-radius:10px;padding:8px 12px;font-size:12.5px;font-weight:600;color:var(--accent-ink);margin-bottom:14px;}
.page-attach-chip a{color:inherit;text-decoration:none;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.page-attach-chip button{background:none;border:none;color:var(--accent-ink);opacity:.7;cursor:pointer;}
.page-attach-chip button:hover{opacity:1;}

/* ===== Card grids ===== */
.grid{display:grid;gap:14px;margin-top:16px;}
.grid-2{grid-template-columns:repeat(2,1fr);}
.grid-3{grid-template-columns:repeat(3,1fr);}
@media (max-width:720px){.grid-2,.grid-3{grid-template-columns:1fr;}}

.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px;box-shadow:var(--shadow);}
.card .ic-wrap{width:38px;height:38px;border-radius:10px;background:var(--accent-soft);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;margin-bottom:12px;}
.card h4{margin:0 0 6px;font-size:15px;font-weight:700;}
.card p{margin:0;font-size:13.5px;color:var(--ink-soft);line-height:1.6;}

.steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px;}
@media (max-width:820px){.steps-grid{grid-template-columns:repeat(2,1fr);}}
.step-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px;position:relative;}
.step-card .num{font-size:12px;font-weight:800;color:#fff;background:var(--accent);width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;}
.step-card h4{margin:0 0 5px;font-size:14px;font-weight:700;}
.step-card p{margin:0;font-size:13px;color:var(--ink-soft);line-height:1.55;}

/* Two column comparison */
.twocol{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px;}
@media (max-width:720px){.twocol{grid-template-columns:1fr;}}
.twocol-col{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px;}
.twocol-col h4{margin:0 0 12px;font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--accent-ink);}
.twocol-col ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px;}
.twocol-col li{font-size:14px;color:var(--ink-soft);line-height:1.5;padding-left:16px;position:relative;}
.twocol-col li::before{content:"—";position:absolute;left:0;color:var(--ink-faint);}

/* Checklist */
.checklist{margin-top:16px;display:flex;flex-direction:column;gap:8px;}
.cl-item{display:flex;align-items:flex-start;gap:12px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:13px 16px;cursor:pointer;transition:.15s;}
.cl-item:hover{border-color:var(--accent);}
.cl-item.checked{background:var(--accent-soft2);border-color:var(--accent-soft);}
.cl-box{flex:0 0 20px;height:20px;border-radius:6px;border:2px solid var(--line);margin-top:1px;display:flex;align-items:center;justify-content:center;transition:.15s;}
.cl-item.checked .cl-box{background:var(--accent);border-color:var(--accent);color:#fff;}
.cl-text{font-size:14px;color:var(--ink);line-height:1.55;}
.cl-item.checked .cl-text{color:var(--ink-soft);text-decoration:line-through;text-decoration-color:var(--ink-faint);}

/* Glossary */
.gloss-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:16px;}
@media (max-width:720px){.gloss-grid{grid-template-columns:1fr;}}
.gloss-col h4{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--accent-ink);margin:0 0 12px;}
.gloss-row{display:flex;gap:14px;padding:10px 0;border-bottom:1px solid var(--line);}
.gloss-row:last-child{border-bottom:none;}
.gloss-term{flex:0 0 88px;font-weight:800;font-size:13px;color:var(--ink);}
.gloss-def{font-size:13.5px;color:var(--ink-soft);line-height:1.5;}

/* Segment (ABCD) */
.segment{display:flex;gap:22px;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:26px;margin-top:16px;}
@media (max-width:640px){.segment{flex-direction:column;}}
.segment-letter{flex:0 0 74px;height:74px;border-radius:16px;background:linear-gradient(155deg,var(--accent),var(--gold));color:#fff;font-size:32px;font-weight:800;display:flex;align-items:center;justify-content:center;}
.segment-body h4{margin:0 0 8px;font-size:17px;font-weight:800;}
.segment-body p{margin:0 0 14px;font-size:14px;color:var(--ink-soft);line-height:1.6;}
.segment-body .sub{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--accent-ink);margin-bottom:10px;}

/* People */
.people-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:16px;}
@media (max-width:820px){.people-grid{grid-template-columns:repeat(2,1fr);}}
.person-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden;}
.person-card .pmeta{padding:12px 14px 16px;}
.person-card .pname{font-size:13.5px;font-weight:700;margin:0 0 2px;}
.person-card .prole{font-size:11.5px;color:var(--ink-faint);margin:0 0 8px;}
.person-card .pnote{font-size:12px;color:var(--ink-soft);line-height:1.5;}

/* ===== Generic small editable text fields ===== */
.editable-field{display:block;border-radius:6px;padding:2px 5px;margin:0 -5px;cursor:text;transition:background .15s,box-shadow .15s;outline:none;}
.editable-field:hover{background:rgba(181,96,42,.06);}
.editable-field:focus{background:#FFFDF9;box-shadow:0 0 0 1.5px var(--accent);}
.editable-field:empty:before{content:attr(data-placeholder);color:var(--ink-faint);font-style:italic;}

/* Contact / final */
.contact-card{background:linear-gradient(155deg,var(--sidebar-bg),#2a241c);color:#fff;border-radius:20px;padding:40px;text-align:center;margin-top:16px;}
.contact-card .handle{display:inline-block;margin-top:16px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);padding:8px 18px;border-radius:20px;font-weight:700;font-size:14px;}
.contact-card .tagline{margin-top:22px;font-size:13px;color:#C9C1B3;font-style:italic;}

/* ===== Media / Photo slot ===== */
.photo-slot{position:relative;border-radius:16px;overflow:hidden;background:var(--accent-soft2);border:1.5px dashed #E3C7A6;min-height:220px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.15s;}
.photo-slot:hover{border-color:var(--accent);}
.photo-slot.has-media{border-style:solid;background:#000;}
.photo-slot input{display:none;}
.photo-slot-empty{text-align:center;padding:30px;color:var(--accent-ink);}
.photo-slot-empty .ic{width:40px;height:40px;margin:0 auto 10px;color:var(--accent);}
.photo-slot-empty .cap-main{font-size:13.5px;font-weight:700;}
.photo-slot-empty .cap-sub{font-size:12.5px;color:#8A6440;margin:8px auto 14px;line-height:1.55;max-width:340px;text-align:left;}
.copy-prompt-btn{position:relative;z-index:2;font-size:11.5px;font-weight:700;color:var(--accent-ink);background:#fff;border:1px solid #E3C7A6;padding:7px 12px;border-radius:20px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:.15s;}
.copy-prompt-btn:hover{background:var(--accent);color:#fff;border-color:var(--accent);}
.photo-slot img,.photo-slot video{width:100%;height:100%;object-fit:cover;display:block;min-height:220px;max-height:420px;}
