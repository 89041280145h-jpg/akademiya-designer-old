function setLink(id,url){ const l=getLinks(); l[id]=url; localStorage.setItem('academyLinks', JSON.stringify(l)); }
function removeLink(id){ const l=getLinks(); delete l[id]; localStorage.setItem('academyLinks', JSON.stringify(l)); }

